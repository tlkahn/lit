{
  "name": "lit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev; stty sane && printf '\\e[0m'",
    "tauri:dev:trial": "LIT_LICENSE_DEV=trial tauri dev; stty sane && printf '\\e[0m'",
    "tauri:dev:expired": "LIT_LICENSE_DEV=trial_expired tauri dev; stty sane && printf '\\e[0m'",
    "tauri:dev:licensed": "LIT_LICENSE_DEV=licensed tauri dev; stty sane && printf '\\e[0m'",
    "test": "bunx vitest run",
    "test:watch": "bunx vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "bench": "bunx vitest bench",
    "test:e2e": "bunx playwright test",
    "test:e2e:headed": "bunx playwright test --headed"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.6.3",
    "@sigma/node-border": "^3.0.0",
    "@sigma/utils": "^3.0.0",
    "@tanstack/react-virtual": "^3.13.24",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "d3-hierarchy": "^3.1.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-zoom": "^3.0.0",
    "graphology": "^0.26.0",
    "graphology-types": "^0.24.8",
    "katex": "^0.16.45",
    "mermaid": "^11.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sigma": "^3.0.3",
    "zustand": "^5.0.12"
  },
  "overrides": {
    "@codemirror/view": "^6.43.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-shape": "^3.1.8",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9",
    "globals": "^16",
    "jsdom": "^26",
    "react-devtools": "^7.0.1",
    "tailwindcss": "^4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8",
    "vite": "^6",
    "vitest": "^3"
  }
}
