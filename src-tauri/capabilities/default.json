{
  "$schema": "https://raw.githubusercontent.com/nicegram/nicegram-tauri/main/.schema/capabilities.json",
  "identifier": "default",
  "description": "Default capabilities for Lit",
  "windows": ["main", "workspace-*"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-set-title",
    "core:window:allow-set-theme",
    "dialog:default",
    "dialog:allow-open",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$HOME/**" }]
    },
    "deep-link:default",
    "updater:default"
  ]
}
