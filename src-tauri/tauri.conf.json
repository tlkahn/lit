{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Lit",
  "version": "0.0.0",
  "identifier": "com.lit.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../themes/lit-nordic/*": "bundled-themes/lit-nordic/",
      "../themes/leuvburn/*": "bundled-themes/leuvburn/",
      "../themes/book/*": "bundled-themes/book/",
      "../src/themes/licenses/*": "licenses/",
      "../keymaps/default.json": "bundled-keymaps/default.json",
      "libs/libpdfium.dylib": "libpdfium.dylib",
      "resources/academic/*": "academic/",
      "resources/academic/csl/*": "academic/csl/"
    },
    "fileAssociations": [
      {
        "ext": [
          "lkg"
        ],
        "mimeType": "application/x-lit-knowledge-graph",
        "description": "Lit Knowledge Graph Bundle"
      }
    ]
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "lit"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1Q0I3N0QzOENDQzhENzgKUldSNGpjeU0wM2ZMUmFwTzNCbHNrVTJob3FKbzU2MXBqVWNhV2VycHZqNm5nVWEwL1V0UWhFMVYK",
      "endpoints": [
        "https://lit.solar/releases/latest.json"
      ]
    }
  }
}
