{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Lit",
  "version": "0.1.0",
  "identifier": "com.lit.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../themes/lit-nordic/*": "bundled-themes/lit-nordic/",
      "../themes/leuvburn/*": "bundled-themes/leuvburn/",
      "../keymaps/default.json": "bundled-keymaps/default.json"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["lit"]
      }
    }
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true
      }
    }
  }
}
